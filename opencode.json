{
  "$schema": "https://opencode.ai/config.json",

  // Local plugin: micode subagent orchestration
  "plugin": ["~/Desktop/extras/micode"],

  // Default model: free (openrouter provider)
  "model": "openrouter/free",

  // Lightweight model for fast tasks (summaries, simple Q&A)
  // "small_model": "anthropic/claude-3-haiku-20240307",

  // Enable bash tool access
  "tools": {
    "bash": true
  },

  // Auto-update enabled
  "autoupdate": true,

  // Session sharing: manual only
  "share": "manual",

  // Provider configurations
  "provider": {
    // opencode: big-pickle (primary)
    "opencode": {
      "models": {
        "big-pickle": {
          "_launch": true,
          "name": "big-pickle"
        }
      }
    },
    // openrouter: local fallback
    "openrouter": {
      "models": {
        "free": {}
      }
    },
    "ollama": {
      "models": {
        "coder11v/mycode1": {
          "_launch": true,
          "name": "coder11v/mycode1"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },

  // Permissions: optimized for Rust development
  "permission": {
    // Allow file edits (local dev project)
    "edit": "allow",
    // Bash: allow common dev commands, gate dangerous ones
    "bash": {
      "cargo *": "allow",
      "git *": "allow",
      "npm *": "allow",
      "rm -rf *": "ask",
      "sudo *": "ask",
      "*": "ask"
    },
    "webfetch": "allow",
    "skill": {
      "*": "allow"
    }
  },

  // Project instructions: load AGENTS.md and CONTRIBUTING.md
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md"
  ],

  // Skills
  "skills": {
    "gemini": {
      "name": "gemini",
      "description": "Gemini CLI for one-shot Q&A, summaries, and generation.",
      "homepage": "https://ai.google.dev/"
    }
  }
}
