{
  "$schema": "https://opencode.ai/config.json",
  "plugin": "/home/user/Desktop/extras/micode",
  "model": "openrouter/free",
  "tools": {
    "bash": true
  },
  "autoupdate": true,
  "share": "manual",
  "provider": {
    "openrouter": {
      "models": ["free"]
    },
    "opencode": {
      "models": {
        "big-pickle": {
          "_launch": true
        }
      }
    },
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "coder11v/mycode1": {
          "_launch": true
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "cargo *": "allow",
      "git *": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "rm -rf *": "ask",
      "sudo *": "deny",
      "*": "ask"
    },
    "webfetch": "allow",
    "skill": {
      "gemini": "allow",
      "rust-expert": "allow",
      "security-auditor": "allow",
      "git-workflow": "allow"
    }
  },
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md"
  ],
  "skills": {
    "gemini": {
      "name": "gemini",
      "description": "Gemini CLI for one-shot Q&A, summaries, and generation.",
      "homepage": "https://ai.google.dev/"
    },
    "rust-expert": {
      "name": "rust-expert",
      "description": "Cargo commands, crate selection, unsafe code review, performance optimization."
    },
    "security-auditor": {
      "name": "security-auditor",
      "description": "OWASP Top 10 detection, vulnerability scanning, audit compliance."
    }
  }
}